{
  "name": "gunbot-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for the Gunbot REST API with configurable permission profiles (read-only, config, operator, full)",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "gunbot-mcp": "dist/index.js" },
  "files": ["dist", "config.example.json", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "keywords": ["mcp", "gunbot", "crypto", "trading-bot", "model-context-protocol"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
